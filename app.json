{
  "expo": {
    "name": "Grievance Officer Desk",
    "slug": "grievance-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neopace.grievance"
    },
    "android": {
      "package": "com.neopace.grievance",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1e3a8a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Grievance App to access your location for live grievance radar telemetry."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Grievance App to access photos for grievance attachments."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "a272d43b-a385-4740-af57-9fe4dfa1137a"
      }
    }
  }
}
